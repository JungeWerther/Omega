worker_processes 1;
error_log /dev/stderr warn;
pid       /tmp/nginx.pid;

events {
    worker_connections 128;
}

http {
    client_body_temp_path /tmp/client_body;
    proxy_temp_path       /tmp/proxy;
    fastcgi_temp_path     /tmp/fastcgi;
    uwsgi_temp_path       /tmp/uwsgi;
    scgi_temp_path        /tmp/scgi;

    access_log /dev/stdout;

    client_max_body_size 16m;

    # Budget for the paid provider routes: the agent can call them directly,
    # so a runaway or prompt-injected agent could otherwise spend without
    # limit. All callers are local, so one shared bucket covers the agent.
    # Rates come from OMEGA_LLM_RATE_PER_MINUTE / OMEGA_LLM_BURST (nginx.sh).
    limit_req_zone $server_port zone=llm_budget:1m rate=${OMEGA_LLM_RATE_PER_MINUTE}r/m;
    limit_req_status 429;

    proxy_connect_timeout 30s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    server {
        # Loopback only: other containers on the Docker network must not be
        # able to borrow the provider credentials injected below.
        listen 127.0.0.1:8080;

        # Uses Anthropic's OpenAI-compatible endpoint (/v1/chat/completions),
        # which accepts Bearer auth like OpenAI. The native /v1/messages API
        # uses x-api-key, but the openai Python client targets the compat endpoint.
        location /anthropic/ {
            limit_req zone=llm_budget burst=${OMEGA_LLM_BURST} nodelay;
            client_max_body_size 4m;
            proxy_pass https://api.anthropic.com/v1/;
            proxy_set_header Authorization "Bearer ${ANTHROPIC_API_KEY}";
            proxy_set_header Host api.anthropic.com;
            proxy_set_header Content-Type $content_type;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location /asicloud/ {
            limit_req zone=llm_budget burst=${OMEGA_LLM_BURST} nodelay;
            client_max_body_size 4m;
            proxy_pass https://inference.asicloud.cudos.org/v1/;
            proxy_set_header Authorization "Bearer ${ASI_API_KEY}";
            proxy_set_header Host inference.asicloud.cudos.org;
            proxy_set_header Content-Type $content_type;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location /openai/ {
            limit_req zone=llm_budget burst=${OMEGA_LLM_BURST} nodelay;
            client_max_body_size 4m;
            proxy_pass https://api.openai.com/v1/;
            proxy_set_header Authorization "Bearer ${OPENAI_API_KEY}";
            proxy_set_header Host api.openai.com;
            proxy_set_header Content-Type $content_type;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location /asione/ {
            limit_req zone=llm_budget burst=${OMEGA_LLM_BURST} nodelay;
            client_max_body_size 4m;
            proxy_pass https://api.asi1.ai/v1/;
            proxy_set_header Authorization "Bearer ${ASIONE_API_KEY}";
            proxy_set_header Host api.asi1.ai;
            proxy_set_header Content-Type $content_type;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location /openaiapi/ {
            limit_req zone=llm_budget burst=${OMEGA_LLM_BURST} nodelay;
            client_max_body_size 4m;
            proxy_pass ${OPENAIAPI_URL};
            proxy_set_header Authorization "Bearer ${OPENAIAPI_API_KEY}";
            proxy_set_header Content-Type $content_type;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        # OpenClaw Gateway: inject Bearer token, upstream is set at container
        # start via the openclaw_url= argument (see entrypoint.sh).
        location = /openclaw/v1/responses {
            limit_req zone=llm_budget burst=${OMEGA_LLM_BURST} nodelay;
            client_max_body_size 4m;
            proxy_pass ${OPENCLAW_URL}v1/responses;
            proxy_set_header Authorization "Bearer ${OMEGA_OPENCLAW_TOKEN}";
            proxy_set_header Content-Type $content_type;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location /openrouter/ {
            limit_req zone=llm_budget burst=${OMEGA_LLM_BURST} nodelay;
            client_max_body_size 4m;
            proxy_pass https://openrouter.ai/api/v1/;
            proxy_set_header Authorization "Bearer ${OPENROUTER_API_KEY}";
            proxy_set_header Host openrouter.ai;
            proxy_set_header Content-Type $content_type;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        # Channel routes are reachable only under /gate/<key>/, where the key
        # is a random value held by the gate process and nginx, never by the
        # agent. Otherwise the agent could read or post as the bot directly,
        # bypassing the gate's sender authentication and target checks.

        # Telegram: rewrite URL to inject bot token in path.
        # The gate calls /gate/<key>/telegram/getUpdates → proxy rewrites to
        # /bot<TOKEN>/getUpdates and forwards to Telegram.
        location /gate/${OMEGA_GATE_KEY}/telegram/ {
            access_log off;
            rewrite ^/gate/${OMEGA_GATE_KEY}/telegram/(.*)$ /bot${TG_BOT_TOKEN}/$1 break;
            proxy_pass https://api.telegram.org;
            proxy_set_header Host api.telegram.org;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
        }

        # Telegram file downloads: Telegram serves uploaded files from
        # /file/bot<TOKEN>/<path>, not /bot<TOKEN>/<path>, so media needs its own.
        location /gate/${OMEGA_GATE_KEY}/telegram-file/ {
            access_log off;
            rewrite ^/gate/${OMEGA_GATE_KEY}/telegram-file/(.*)$ /file/bot${TG_BOT_TOKEN}/$1 break;
            proxy_pass https://api.telegram.org;
            proxy_set_header Host api.telegram.org;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_max_temp_file_size 0;
        }

        # Mattermost: inject Bearer token header (HTTP + WebSocket).
        # Origin is rewritten to the upstream URL so Mattermost's CORS check
        # on the WebSocket upgrade matches its SiteURL / AllowCorsFrom — the
        # agent's auto-derived Origin (http://gateway:8080) is not trusted.
        location /gate/${OMEGA_GATE_KEY}/mattermost/ {
            access_log off;
            proxy_pass ${MM_URL};
            proxy_set_header Authorization "Bearer ${MM_BOT_TOKEN}";
            proxy_set_header Host $proxy_host;
            proxy_set_header Origin "${MM_UPSTREAM_URL}";
            proxy_set_header Content-Type $content_type;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 300s;
        }

        location /gate/${OMEGA_GATE_KEY}/slack/ {
            access_log off;
            proxy_pass https://slack.com/;
            proxy_set_header Authorization "Bearer ${SL_BOT_TOKEN}";
            proxy_set_header Host slack.com;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
        }

        # Slack private file downloads.
        location /gate/${OMEGA_GATE_KEY}/slack-files/ {
            access_log off;
            proxy_pass https://files.slack.com/;

            proxy_set_header Authorization "Bearer ${SL_BOT_TOKEN}";
            proxy_set_header Host files.slack.com;

            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_http_version 1.1;
        }

        location /health {
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }
    }
}

